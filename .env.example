# Copy to .env if you need it. Never commit .env (git-ignored).
# The app itself needs NO environment variables (offline-first).

# Optional: GitHub MCP server in .mcp.json reads this token from your SHELL environment.
# Fine-grained token: https://github.com/settings/personal-access-tokens
#   Repository access: Emir-pek/astroVital only → Contents, Issues, Pull requests (read/write)
#   Windows:      setx GITHUB_PERSONAL_ACCESS_TOKEN "..."   (then open a new terminal)
#   macOS/Linux:  export GITHUB_PERSONAL_ACCESS_TOKEN=...   (add to ~/.zshrc or ~/.bashrc)
GITHUB_PERSONAL_ACCESS_TOKEN=
